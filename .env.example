# Общий ключ вызова между сервисами. ОБЯЗАТЕЛЕН (не короче 16 знаков): без него сервис не стартует.
# Сгенерировать: openssl rand -hex 32
EXTRACT_API_KEY=

# Порт внутри контейнера (наружу не публикуется).
PORT=3000

# Потолок размера файла, байт (20 МБ).
MAX_FILE_BYTES=20971520
# Потолок текста в ответе, знаков; длиннее — обрезается, truncated: true.
MAX_TEXT_CHARS=2000000
# Сколько файлов разбирается одновременно; остальные ждут в очереди.
MAX_CONCURRENCY=2
# Сколько файл может ждать места в очереди, мс; дольше — 503 busy.
QUEUE_TIMEOUT_MS=60000
# Потолок времени разбора одного файла, мс; дольше — 504 timeout, процессы убиваются.
EXTRACT_TIMEOUT_MS=120000

# Кеш на 24 часа. Задан REDIS_URL — кеш в Redis, иначе — каталог CACHE_DIR.
REDIS_URL=
CACHE_DIR=/tmp/file-extract-cache
