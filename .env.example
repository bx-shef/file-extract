# Общий ключ вызова между сервисами. ОБЯЗАТЕЛЕН (не короче 16 знаков): без него сервис не стартует.
# Сгенерировать: openssl rand -hex 32
EXTRACT_API_KEY=

# Адрес, на котором слушает сервис. По умолчанию 127.0.0.1 (только локально); в образе Dockerfile
# задаёт 0.0.0.0 — соседи по внутренней сети должны его видеть.
HOST=127.0.0.1
# Порт внутри контейнера (наружу не публикуется).
PORT=3000

# Потолок размера файла, байт (20 МБ).
MAX_FILE_BYTES=20971520
# Потолок текста в ответе, знаков; длиннее — обрезается, truncated: true.
MAX_TEXT_CHARS=2000000
# Сколько файлов разбирается одновременно; остальные ждут в очереди.
MAX_CONCURRENCY=2
# Сколько запросов может ждать места сверх идущих разборов; сверх — сразу 503 busy.
# Столько же запросов (разборы + очередь) одновременно держат тело в памяти (до MAX_FILE_BYTES).
MAX_QUEUE=8
# Сколько файл может ждать места в очереди, мс; дольше — 503 busy.
QUEUE_TIMEOUT_MS=60000
# Потолок времени разбора одного файла, мс; дольше — 504 timeout, процессы убиваются.
# 5 минут — OCR скана в 30 страниц по очереди на одном ядре.
EXTRACT_TIMEOUT_MS=300000

# Кеш на 24 часа. Задан REDIS_URL — кеш в Redis, иначе — каталог CACHE_DIR.
REDIS_URL=
CACHE_DIR=/tmp/file-extract-cache
# Потолок дискового кеша, байт (256 МБ); сверх — вытесняются записи, истекающие раньше.
CACHE_MAX_BYTES=268435456
