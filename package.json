{
  "name": "file-extract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Сервис разбора файлов: текст и таблицы из PDF, Office, картинок и текстовых файлов",
  "engines": { "node": ">=22.18" },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "start": "node --experimental-strip-types src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "ioredis": "5.8.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
